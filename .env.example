# ArcoDataHub credentials (see Module 1) — used by both modules to access
# the cloud-native radar Zarr datasets.
#
# Copy this file to `.env` (same folder) and fill in your own values:
#   cp .env.example .env
# `.env` is gitignored — never commit real credentials.

ARCODATAHUB_USERNAME=
ARCODATAHUB_ACCESS_KEY=
